// Cloudflare Workers config (Workers Builds project `astro-kings`).
// The site is static files from `npm run build` (dist/), served with
// public/_headers. worker/index.js only handles what isn't a file: the
// /api/submit form endpoint. Secrets are listed in worker/submit.js.
{
  "name": "astro-kings",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
